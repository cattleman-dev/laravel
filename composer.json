{
    "name": "cattleman-dev/laravel",
    "description": "An artisan command palette for setting up Cattleman modules (Sockets first) in a Laravel app.",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel", "cattleman", "cloudflare", "websockets", "pusher", "broadcasting"],
    "homepage": "https://cattleman.dev",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "laravel/prompts": "^0.1.18 || ^0.2 || ^0.3"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "phpunit/phpunit": "^11.0",
        "pusher/pusher-php-server": "^7.2"
    },
    "autoload": {
        "psr-4": {
            "Cattleman\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Cattleman\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Cattleman\\Laravel\\CattlemanServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
